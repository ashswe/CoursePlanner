<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoursePlanner.Pages.AddCourse"
             Title="Add Course"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout 
        Spacing="0">

            <!-- Header -->
            <Grid 
            Padding="20,20,20,10"
            ColumnDefinitions="Auto,*">

                <Label 
                Grid.Column="1"
                Text="Add Course"
                FontSize="40"
                FontFamily="HussarBold"
                TextColor="{StaticResource MutedNavy}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            </Grid>

            <!-- Divider -->
            <BoxView 
                Margin="0,10,0,10"/>

            <VerticalStackLayout 
            Padding="20,0,20,20"
            Spacing="14">

                <!-- Course Name -->
                <Entry 
                x:Name="CourseNameEntry"
                Placeholder="Course Name"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

                <!-- Course Start/End Dates & Status Picker -->
                <Grid 
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                    <Label 
                    Text="Start Date:"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                    <DatePicker 
                    x:Name="CourseStartDatePicker"
                    Grid.Column="1"
                    FontSize="16" />

                </Grid>

                <Grid 
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                    <Label 
                    Text="End (Due) Date:"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                    <DatePicker 
                    x:Name="CourseEndDatePicker"
                    Grid.Column="1"
                    FontSize="16" />

                </Grid>

                <Grid 
                ColumnDefinitions="Auto,*"
                ColumnSpacing="12">

                    <Label 
                    Text="Status:"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                    <Picker 
                    x:Name="StatusPicker"
                    Grid.Column="1"
                    Title="Select status"
                    FontSize="16">

                        <Picker.Items>
                            <x:String>In Progress</x:String>
                            <x:String>Completed</x:String>
                            <x:String>Dropped</x:String>
                            <x:String>Plan to Take</x:String>
                        </Picker.Items>
                    </Picker>

                </Grid>

                <BoxView 
                HeightRequest="1"
                BackgroundColor="#A8A8A8"
                Margin="0,4,0,0" />

                <!-- Instructor Info -->
                <Label 
                    Text="Instructor:"
                    FontAttributes="Bold"
                    FontSize="18" />

                <Entry 
                    x:Name="InstructorNameEntry"
                    Placeholder="Instructor Name"
                    FontSize="16"/>

                <Label 
                    Text="Instructor Phone:"
                    FontAttributes="Bold"
                    FontSize="18" />

                <Entry 
                    x:Name="InstructorPhoneEntry"
                    Placeholder="Instructor Phone"
                    Keyboard="Telephone"
                    FontSize="16" />

                <Label 
                    Text="Instructor Email:"
                    FontAttributes="Bold"
                    FontSize="18" />

                <Entry 
                    x:Name="InstructorEmailEntry"
                    Placeholder="Instructor Email"
                    Keyboard="Email"
                    FontSize="16"/> 

                <BoxView />

                <!-- Course Notes -->
                <Label 
                Text="Notes"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="{StaticResource MutedNavy}" />

                <Editor 
                x:Name="NotesEditor"
                HeightRequest="120"
                FontSize="16"
                AutoSize="TextChanges" />

                <BoxView  />

                <!-- Course Notifications -->
                <Label 
                Text="Notifications"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="{StaticResource MutedNavy}" />

                <Grid 
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="14">

                    <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Alert for Course Start"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                    <Switch 
                    x:Name="CourseStartAlertSwitch"
                    Grid.Row="0"
                    Grid.Column="1" />

                    <Label 
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Alert for Course End"
                    FontSize="18"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                    <Switch 
                    x:Name="CourseEndAlertSwitch"
                    Grid.Row="1"
                    Grid.Column="1" />

                </Grid>

                <BoxView />

                <!-- Course Add Button -->
                <Button 
                Text="ADD"
                Clicked="AddCourseButton_Clicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>