<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoursePlanner.Pages.Login"
             Title="Login"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout
            Padding="0,30,0,30"
            Spacing="0">

            <!-- Logo -->
            <Image
                x:Name="LogoImage"
                Source="logo.png"
                HeightRequest="200"
                WidthRequest="200"
                HorizontalOptions="Center"
                Margin="0,20,0,10" />

            <!-- App Title -->
            <Label
                Text="Course&#10;Planner"
                FontFamily="HussarBold"
                FontSize="50"
                TextColor="{StaticResource MutedNavy}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,30" />

            <!-- Divider -->
            <BoxView
                HeightRequest="1" />

            <!-- Form Section -->
            <VerticalStackLayout
                Padding="40,0"
                Spacing="0">

                <!-- Username -->
                <Label
                    Text="Username:"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,20,0,10" />

                <Entry
                    x:Name="UsernameEntry"
                    HeightRequest="42"
                    Placeholder="Username"
                    Margin="0,0,0,28" />

                <!-- Password -->
                <Label
                    Text="Password:"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,0,0,10" />

                <Entry
                    x:Name="PasswordEntry"
                    IsPassword="True"
                    HeightRequest="42"
                    Placeholder="Password"
                    Margin="0,0,0,18" />

            </VerticalStackLayout>

            <Grid
                    RowDefinitions="Auto,Auto">
                    <!-- Register Button -->
                    <Button
                        Grid.Row="0"
                        x:Name="RegisterButton"
                        Text="REGISTER"
                        Clicked="RegisterButton_Clicked"/>

                    <!-- Login Button -->
                <Button
                    Grid.Row="1"
                    x:Name="LoginButton"
                    Text="LOGIN"
                    Clicked="LoginButton_Clicked"/>
            </Grid>
         </VerticalStackLayout>
    </ScrollView>
</ContentPage>