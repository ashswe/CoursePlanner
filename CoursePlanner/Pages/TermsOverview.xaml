<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CoursePlanner.Pages.TermsOverview"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CoursePlanner.Models"
    Title="Course Planner"
    BackgroundColor="White">

    <Grid 
        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
        Padding="0">

        <!-- Logo Image -->
        <Image 
           Grid.Row="0"
           Source="logo.png"
           WidthRequest="130"
           HeightRequest="130"
           Aspect="AspectFit"
           HorizontalOptions="End"
           VerticalOptions="Start"
           Margin="0,0,20,0"/>   

        <!-- Header -->
        <Grid 
            Grid.Row="1"
            Padding="20,10,20,10">

            <VerticalStackLayout 
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,10,0,10">

                <Label 
                    Text="Term"
                    FontFamily="HussarBold"
                    FontSize="50"
                    TextColor="{StaticResource MutedNavy}"
                    HorizontalTextAlignment="Center" />

                <Label 
                    Text="Overview"
                    FontFamily="HussarBold"
                    FontSize="50"
                    TextColor="{StaticResource MutedNavy}"
                    HorizontalTextAlignment="Center" />
                
            </VerticalStackLayout>
        </Grid>

        <!-- Divider -->
        <BoxView 
            Grid.Row="2"
            Margin="0,0,0,10" />

        <!-- Terms List -->
        <CollectionView 
            Grid.Row="3"
            x:Name="TermsCollectionView"
            ItemsSource="{Binding Terms}"
            SelectionMode="Single"
            SelectionChanged="TermsCollectionView_SelectionChanged">

            <CollectionView.EmptyView>
                <VerticalStackLayout 
                    Padding="30,40"
                    Spacing="10">
                    
                    <Label 
                        Text="No terms added yet."
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    
                    <Label 
                        Text="Tap + ADD TERM to create your first term."
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />
                    
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate 
                    x:DataType="models:Term">
                    
                    <VerticalStackLayout 
                        Padding="28,10"
                        Spacing="2">
                        
                        <Label 
                            Text="{Binding Title}"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="Black" />

                        <Label 
                            FontSize="16"
                            TextColor="Black">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding StartDate, StringFormat='{0:MM, dd, yyyy}'}" />
                                    <Span Text=" - " />
                                    <Span Text="{Binding EndDate, StringFormat='{0:MM, dd, yyyy}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Helper Text -->
        <Label 
            Grid.Row="4"
            Text="Tap term to view details/courses"
            FontSize="18"
            HorizontalOptions="Center"
            Margin="0,10,0,14" />

        <!-- Bottom Section -->
        <VerticalStackLayout 
            Grid.Row="5">
            
            <BoxView/>

            <Grid
                RowDefinitions="Auto,Auto">
                <Button 
                    Grid.Row="0"
                    Text="+ ADD TERM"
                    Clicked="AddTermButton_Clicked" />

                <Button 
                    Grid.Row="1"
                    Text="PROGRESS REPORT"
                    Clicked="ReportButton_Clicked" />
            </Grid>

        </VerticalStackLayout>
    </Grid>
</ContentPage>