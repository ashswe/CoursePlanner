<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoursePlanner.Pages.AssessmentDetails"
             Title="Assessment Details"
             BackgroundColor="White">
    
    <ScrollView>
        <VerticalStackLayout 
            Spacing="14"
            Padding="20">

            <!-- Header -->
            <Grid
                Padding="20,10,20,10"
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto">
                
                <Label
                    Grid.Column="1"
                    Text="Assessment&#10;Details"
                    FontSize="40"
                    FontFamily="HussarBold"                   
                    TextColor="{StaticResource MutedNavy}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    Margin="-40,0,0,0" />
            </Grid>

            <BoxView 
                Margin="0,10,0,10" />

            <!-- Main Content -->
            <VerticalStackLayout
                Padding="20,10,20,0"
                Spacing="18">

                <!-- Assessment Title -->
                <VerticalStackLayout 
                    Spacing="6">
                    <Label
                        Text="Assessment Title:"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="AssessmentTitleEntry"
                        HeightRequest="40" />
                </VerticalStackLayout>

                <!-- Type -->
                <VerticalStackLayout 
                    Spacing="6">
                    <Label
                        Text="Type:"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="AssessmentTypePicker"
                        Title="Select Type"
                        HeightRequest="40">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>OA</x:String>
                                <x:String>PA</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Start Date -->
                <VerticalStackLayout 
                    Spacing="6">
                    <Label
                        Text="Start Date:"
                        FontSize="18"
                        FontAttributes="Bold" />
                    
                    <Grid 
                        ColumnDefinitions="*,Auto" 
                        ColumnSpacing="10">

                        <DatePicker
                            x:Name="StartDatePicker"
                            Grid.Column="0"
                            HeightRequest="40"
                            FontSize="16"
                            Format="MM, dd, yyyy" />
                    </Grid>
                </VerticalStackLayout>

                <!-- End Date -->
                <VerticalStackLayout 
                    Spacing="6">
                    <Label
                        Text="End Date:"
                        FontSize="18"
                        FontAttributes="Bold" />
                    
                    <Grid 
                        ColumnDefinitions="*,Auto" 
                        ColumnSpacing="10">
                        <DatePicker
                            x:Name="EndDatePicker"
                            Grid.Column="0"
                            HeightRequest="40"
                            FontSize="16"
                            Format="MM, dd, yyyy" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Notifications Section -->
            <BoxView 
                HeightRequest="1" 
                Margin="0,5,0,0" />

            <VerticalStackLayout
                Padding="0,0,0,0"
                Spacing="14">

                <Label
                    Text="Notifications"
                    FontSize="22"
                    FontAttributes="Bold"
                    Padding="8,0,0,0" />

                <Grid
                    Padding="20,0,20,0"
                    RowDefinitions="Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    RowSpacing="14">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Alert for Assessment Start"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center" />

                    <Switch
                        x:Name="AssessmentStartNotifSwitch"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalOptions="End" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Alert for Assessment End"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center" />

                    <Switch
                        x:Name="AssessmentEndNotifSwitch"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalOptions="End" />
                </Grid>
            </VerticalStackLayout>

            <!-- Spacer -->
            <Grid HeightRequest="140" />

            <!-- Bottom Buttons -->
            <BoxView HeightRequest="1" />

            <Grid
                ColumnDefinitions="*,*"
                Margin="0,10,0,20">

                <Button
                    x:Name="UpdateAssessmentButton"
                    Grid.Column="0"
                    Text="UPDATE" 
                    Clicked="UpdateButton_Clicked"/>

                <Button
                    x:Name="DeleteAssessmentButton"
                    Grid.Column="1"
                    Text="DELETE"
                    Clicked="DeleteButton_Clicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>