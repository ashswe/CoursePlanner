<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoursePlanner.Pages.CourseDetails"
             Title="Course Details"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout 
            Padding="20" 
            Spacing="14">
            <!-- Header -->
            <Grid 
                Padding="20,10,20,10"
                RowDefinitions="Auto">

                <Label 
                    Grid.Row="0"
                    Text="Course Details"
                    FontFamily="HussarBold"
                    TextColor="{StaticResource MutedNavy}"
                    FontSize="40"
                    HorizontalTextAlignment="Center" /> 
            </Grid>

            <BoxView 
                Margin="0,10,0,10"  />

            <!-- Course Name -->
            <Entry 
                x:Name="CourseNameEntry"
                Placeholder="Course Name"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                ClearButtonVisibility="WhileEditing" />

            <!-- Dates -->
            <Grid 
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Start Date:"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="18"/>

                <DatePicker 
                    x:Name="CourseStartDatePicker"
                    Grid.Row="0"
                    Grid.Column="1"
                    Format="MM/dd/yyyy"
                    FontSize="16" />

                <Label 
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="End (Due) Date:"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="18" />

                <DatePicker 
                    x:Name="CourseEndDatePicker"
                    Grid.Row="1"
                    Grid.Column="1"
                    Format="MM/dd/yyyy"
                    FontSize="16" />

                <!-- Status Picker -->
                <Label 
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Status:"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="18" />

                <Picker 
                    x:Name="StatusPicker"
                    Grid.Row="2"
                    Grid.Column="1"
                    Title="Select Status"
                    FontSize="16" >

                    <Picker.ItemsSource>
                        <x:Array 
                            Type="{x:Type x:String}">
                            <x:String>In Progress</x:String>
                            <x:String>Completed</x:String>
                            <x:String>Dropped</x:String>
                            <x:String>Plan To Take</x:String>
                        </x:Array>
                    </Picker.ItemsSource>

                </Picker>
            </Grid>

            <BoxView 
                HeightRequest="1" />

            <!-- Instructor Info -->
            <Label 
                Text="Instructor:"
                FontAttributes="Bold"
                FontSize="18" />

            <Entry 
                x:Name="InstructorNameEntry"
                Placeholder="Instructor Name"
                FontSize="16"/>

            <Label 
                Text="Instructor Phone:"
                FontAttributes="Bold"
                FontSize="18" />

            <Entry 
                x:Name="InstructorPhoneEntry"
                Placeholder="Instructor Phone"
                Keyboard="Telephone"
                FontSize="16" />

            <Label 
                Text="Instructor Email:"
                FontAttributes="Bold"
                FontSize="18" />

            <Entry 
                x:Name="InstructorEmailEntry"
                Placeholder="Instructor Email"
                Keyboard="Email"
                FontSize="16"/>

            <BoxView HeightRequest="1" />

            <!-- Notes -->
            <Grid 
                ColumnDefinitions="*,Auto, Auto">

                <Label 
                    Text="Notes"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <Button 
                    x:Name="DisplayNotesButton"
                    Grid.Column="2"
                    Text="+"
                    FontSize="22"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent"
                    Clicked="DisplayNotesButton_Clicked" />
            </Grid>

            <VerticalStackLayout 
                x:Name="NotesSection"
                IsVisible="False"
                Spacing="10">

                <Editor 
                    x:Name="NotesEditor"
                    Placeholder="Optional notes"
                    AutoSize="TextChanges"
                    HeightRequest="120"
                    FontSize="16"/>

                <Button 
                    x:Name="ShareNotesButton"
                    Text="SHARE"
                    HorizontalOptions="End"
                    WidthRequest="140"
                    Clicked="ShareNotesButton_Clicked" />

            </VerticalStackLayout>

            <BoxView HeightRequest="1" />

            <!-- Alerts -->
            <Grid 
                ColumnDefinitions="*,Auto"
                RowDefinitions="Auto,Auto"
                RowSpacing="14">

                <Label 
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Alert for Course Start"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    FontSize="18" />

                <Switch 
                    x:Name="CourseStartAlertSwitch"
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalOptions="Center" />

                <Label 
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Alert for Course End"
                    FontAttributes="Bold"
                    FontSize="18"
                    VerticalOptions="Center" />

                <Switch 
                    x:Name="CourseEndAlertSwitch"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalOptions="Center" />
            </Grid>

            <BoxView HeightRequest="1" />

            <!-- Assessments -->
            <Grid 
                ColumnDefinitions="*,Auto">

                <Label 
                    Text="Assessments"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <Button 
                    x:Name="AddAssessmentButton"
                    Grid.Column="1"
                    Text="+"
                    WidthRequest="40"
                    HeightRequest="40"
                   Clicked="AddAssessmentButton_Clicked" />

            </Grid>

            <!-- Assessments List -->
            <CollectionView 
                x:Name="AssessmentsCollectionView"
                SelectionMode="Single"
                SelectionChanged="AssessmentsCollectionView_SelectionChanged"
                HeightRequest="180">

                <CollectionView.EmptyView>

                    <Label 
                        Text="No assessments added yet."
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="Gray" />

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border 
                            Margin="0,4"
                            Padding="10">

                            <Grid 
                                ColumnDefinitions="50,*,Auto"
                                RowDefinitions="Auto">

                                <Label 
                                    Grid.Column="0"
                                    Text="{Binding Type}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    VerticalOptions="Center" />

                                <Label 
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    VerticalOptions="Center" />

                                <Label 
                                    Grid.Column="2"
                                    Text="{Binding EndDate, StringFormat='Due {0:MM/dd/yyyy}'}"
                                    FontSize="16"
                                    VerticalOptions="Center" />
                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label 
                Text="Tap assessment to view/edit details"
                HorizontalOptions="Center"
                FontAttributes="Italic"
                TextColor="Gray" />

            <BoxView HeightRequest="1" />

            <!-- Bottom Buttons -->
            <Grid 
                ColumnDefinitions="*,*"
                Margin="0,10,0,20">

                <Button 
                    x:Name="UpdateCourseButton"
                    Grid.Column="0"
                    Text="UPDATE"
                    Clicked="UpdateCourseButton_Clicked" />

                <Button 
                    x:Name="DeleteCourseButton"
                    Grid.Column="1"
                    Text="DELETE"
                    Clicked="DeleteCourseButton_Clicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>